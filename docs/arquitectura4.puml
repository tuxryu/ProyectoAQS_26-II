@startuml
title Arquitectura Limpia - Ecosistema de Microservicios sin base de datos local
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontSize 12

rectangle "Capa 4: Frameworks y Drivers - Java 25 / Spring Boot 4.1.1" as C4a #E8EAE8 {
  component "<<Interfaz de Usuario>>\nIU Web, módulo ui-web:8080\n--\n• Menú con los 8 casos de uso (req. 14 a 19)\n• Notificación de resultados (req. 17)\n• Salida: petición HTTP/JSON a los 3 MS" as UI #ADD8E6
}

rectangle "Capa 3: Adaptadores de Entrada (REST)" as C3in #EAF4FB {
  component "<<Adaptador REST>>\nClienteController:8081\n--\n• POST /clientes, PUT /clientes/{curp}\n• GET /clientes/{curp} (inter-servicio)\n• Mapea DTO ↔ dominio" as ACli #90EE90
  component "<<Adaptador REST>>\nPolizaController:8082\n--\n• GET /polizas (filtro + paginación)\n• POST, PATCH, DELETE ?confirmar=true\n• Mapea DTO ↔ dominio" as APol #90EE90
  component "<<Adaptador REST>>\nBeneficiarioController:8083\n--\n• POST /polizas/{clave}/beneficiarios\n• GET /polizas/{clave}/beneficiarios?...\n• Mapea DTO ↔ dominio" as ABen #90EE90
}

rectangle "Capa 2: Casos de Uso (un microservicio = un bloque desplegable)" as C2 #F0E9F8 {

  package "MS Clientes" as MSC {
    interface "Alta / Modificar / Consultar\nClienteUseCase (entrada)" as PInCli
    component "<<Caso de uso>>\nClienteService\n--\n• Alta: CURP mayúsculas, 409 si existe\n• Modificación: PUT o POST según 2º apellido\n• Relee y compara tras escribir" as SCli #9370DB
    interface "ClienteRemotoPort\n(salida)" as POutCli
  }

  package "MS Pólizas" as MSP {
    interface "Alta / Consulta / Gestionar\nPolizaUseCase (entrada)" as PInPol
    component "<<Caso de uso>>\nPolizaService (coordinador)\n--\n• Alta - UUID / Modif. / Baja\n• exigirRegistrado(curp) antes de escribir (insert,...)\n• Consulta con 6 filtros, paginación en memoria" as SPol #9370DB
    interface "PolizaRemotaPort\n(salida)" as POutPol
    interface "ClienteServicioPort\n(salida inter-servicio)" as POutPolCli
  }

  package "MS Beneficiarios" as MSB {
    interface "Alta / Consulta\nBeneficiarioUseCase (entrada)" as PInBen
    component "<<Caso de uso>>\nBeneficiarioService\n--\n• Alta: exige póliza (404), duplicado (409)\n• Consulta por póliza + datos completos\n• Suma 100%, buscar como verificar (limitación)" as SBen #9370DB
    interface "BeneficiarioRemotoPort\n(salida)" as POutBen
    interface "PolizaServicioPort\n(salida inter-servicio)" as POutBenPol
  }
}

rectangle "Capa 1: Entidades - reglas de negocio, sin persistencia local" as C1 #FAFAFA {
  component "<<Entidad>>\nCliente\n--\n• nombres: String(128)\n• primerApellido: String(128)\n• segundoApellido: String(128) [opcional]\n• direccion: String(512)\n• curp: String(18) [identificador]\n• fechaNacimiento: LocalDate" as ECli #White
  component "<<Entidad>>\nPoliza\n--\n• clave: UUID [identificador]\n• tipo: TipoPoliza (0=Auto,1=Vida,2=Médico)\n• monto: BigDecimal - (9.2)\n• descripcion: String (sin / ni \\)\n• curpCliente: String(18) [referencia]" as EPol #White
  component "<<Entidad>>\nBeneficiario\n--\n• nombres, primerApellido: String(128)\n• segundoApellido: String(128) [opcional]\n• fechaNacimiento: LocalDate\n• clavePoliza: UUID [referencia]\n• porcentaje: int (1..100)" as EBen #White
}

rectangle "Capa 3: Adaptadores de Salida (REST Client)" as C3out #FFF8E5 {
  component "<<Cliente REST>>\nAdaptadores Sistema Dueño (uno por MS)\nClienteSistemaDuenoAdapter / PolizaSistemaDuenoAdapter /\nBeneficiarioSistemaDuenoAdapter\n--\n• DTO + mapper (JSON camelCase; fechas timestamp → LocalDate CDMX)\n• Atributos como segmentos de ruta codificados (prohíbe / y \\)\n• 200 vacío → no existe (lectura) o rechazo (escritura); [] → sin resultados\n• 500 → rechazo de datos (502); 502/503/504/red/timeout → no disponible (503)\n• Filas inválidas se omiten y se registran en log" as AOut #FFA500
  component "<<Cliente REST>>\nAdaptadores Inter-servicio\n--\n• ClienteRestAdapter: GET :8081/clientes/{curp}\n• PolizaRestAdapter: GET :8082/polizas/{clave}\n• Timeout / MS caído → 503" as AInt #FFA500
}

cloud "Capa 4: Infraestructura Remota y única fuente de datos" as C4b #FDECEC {
  component "<<Sistema Externo>>\nSistema Dueño de Pólizas\nhttp://nachintoch.mx:8080\n--\n• 15 endpoints: 9 GET, 3 POST, 2 PUT, 1 DELETE\n• Parámetros en la ruta (sin cuerpo), respuesta JSON\n• POST = upsert; casi no valida; DELETE en cascada\n• Sin endpoints para listar clientes ni editar/borrar beneficiarios" as EXT #FFC0CB
}

UI --> ACli : HTTP/JSON
UI --> APol : HTTP/JSON
UI --> ABen : HTTP/JSON

ACli --> PInCli : invoca
APol --> PInPol : invoca
ABen --> PInBen : invoca

' El servicio IMPLEMENTA el puerto de entrada
SCli .up.|> PInCli
SPol .up.|> PInPol
SBen .up.|> PInBen

' El servicio USA los puertos de salida
SCli --> POutCli : usa
SPol --> POutPol : usa
SPol --> POutPolCli : usa
SBen --> POutBen : usa
SBen --> POutBenPol : usa

SCli ..> ECli : usa y valida
SPol ..> EPol : usa y valida
SBen ..> EBen : usa y valida

' Inversión de dependencias: el ADAPTADOR implementa el puerto
AOut .up.|> POutCli : implementa
AOut .up.|> POutPol : implementa
AOut .up.|> POutBen : implementa
AInt .up.|> POutPolCli : implementa
AInt .up.|> POutBenPol : implementa

AOut --> EXT : HTTP/REST\n(GET, POST, PUT, DELETE)
AInt --> ACli : HTTP/REST
AInt --> APol : HTTP/REST

@enduml
